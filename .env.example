# Demo deployment environment
#
# Copy this file to .env before running docker compose:
#   cp .env.example .env

MYSQL_ROOT_PASSWORD=mall_demo_root_2026
MYSQL_DATABASE=mall_db
MYSQL_PORT=3307
DB_USERNAME=root
DB_PASSWORD=mall_demo_root_2026

BACKEND_PORT=8080
FRONTEND_PORT=8088

SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=mall-demo-jwt-secret-at-least-32-bytes-2026
JWT_EXPIRATION_MINUTES=10080
CORS_ALLOWED_ORIGINS=*

UPLOAD_DIR=/app/uploads
UPLOAD_BASE_URL=/uploads
UPLOAD_MAX_FILE_SIZE=2MB
UPLOAD_MAX_REQUEST_SIZE=3MB
UPLOAD_MAX_SIZE_BYTES=2097152
