# Production deployment environment template.
# Copy to .env on the server and replace every change-me value.

MYSQL_ROOT_PASSWORD=change-me-root-password-at-least-16-chars
MYSQL_DATABASE=mall_db
MYSQL_USER=mall_app
MYSQL_PASSWORD=change-me-app-password-at-least-16-chars

FRONTEND_PORT=8088

JWT_SECRET=change-me-jwt-secret-at-least-32-bytes-long
JWT_EXPIRATION_MINUTES=10080
CORS_ALLOWED_ORIGINS=https://your-domain.com

UPLOAD_DIR=/app/uploads
UPLOAD_BASE_URL=/uploads
UPLOAD_MAX_FILE_SIZE=2MB
UPLOAD_MAX_REQUEST_SIZE=3MB
UPLOAD_MAX_SIZE_BYTES=2097152
