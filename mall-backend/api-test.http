@baseUrl = http://localhost:8088/api
@backendUrl = http://localhost:8080/api
@userToken =
@adminToken =
@demoAddressId = 1
@demoCartItemId = 1
@createdOrderId =
@cancelOrderCartItemId =
@cancelOrderId =
@uploadedImageUrl =

### 0. 前端代理健康检查，演示模式推荐
GET {{baseUrl}}/health

### 0.1 后端直连健康检查
GET {{backendUrl}}/health

### 1. 普通用户登录，明文密码 user123456
POST {{baseUrl}}/user/login
Content-Type: application/json

{
  "username": "user",
  "password": "user123456"
}

> {% client.global.set("userToken", response.body.data.token); %}

### 2. 管理员登录，明文密码 admin123456
POST {{baseUrl}}/user/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123456"
}

> {% client.global.set("adminToken", response.body.data.token); %}

### 3. 禁用用户登录，预期失败
POST {{baseUrl}}/user/login
Content-Type: application/json

{
  "username": "disabled_demo",
  "password": "user123456"
}

### 4. 游客查询分类
GET {{baseUrl}}/categories

### 5. 游客查询商品列表
GET {{baseUrl}}/products?page=1&size=8&keyword=&categoryId=

### 6. 游客查看商品详情
GET {{baseUrl}}/products/3

### 7. 未登录访问购物车，预期返回 401
GET {{baseUrl}}/cart

### 8. 普通用户查询购物车
GET {{baseUrl}}/cart
Authorization: Bearer {{userToken}}

### 9. 加入购物车，演示商品：智能手环
POST {{baseUrl}}/cart
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "productId": 3,
  "quantity": 1
}

### 10. 查询购物车并记录商品 3 的购物车项 ID
GET {{baseUrl}}/cart
Authorization: Bearer {{userToken}}

> {%
  const item = response.body.data.find(row => row.productId === 3);
  if (item) {
    client.global.set("demoCartItemId", item.id);
  }
%}

### 11. 新增演示地址并记录地址 ID
POST {{baseUrl}}/address
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "receiverName": "演示用户",
  "receiverPhone": "13600000000",
  "province": "江苏省",
  "city": "南京市",
  "detailAddress": "数据库实验楼 305",
  "isDefault": 1
}

> {% client.global.set("demoAddressId", response.body.data.id); %}

### 12. 创建订单，并记录订单 ID
# 数据库观察点：
# - order_info 新增订单主表
# - order_item 新增商品快照
# - product.stock 扣减，product.sales 增加
# - cart_item 中对应购物车项被清理
POST {{baseUrl}}/orders
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "addressId": {{demoAddressId}},
  "cartItemIds": [{{demoCartItemId}}]
}

> {% client.global.set("createdOrderId", response.body.data.orderId); %}

### 13. 查询用户订单列表
GET {{baseUrl}}/orders?page=1&size=10
Authorization: Bearer {{userToken}}

### 14. 查询新订单详情
GET {{baseUrl}}/orders/{{createdOrderId}}
Authorization: Bearer {{userToken}}

### 15. 用户提交付款备注，新订单仍保持待支付，等待管理员确认收款
PUT {{baseUrl}}/orders/{{createdOrderId}}/payment-note
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "paymentNote": "微信转账尾号 2026，备注订单号"
}

### 16. 管理员查询待支付订单
GET {{baseUrl}}/admin/orders?page=1&size=10&status=0
Authorization: Bearer {{adminToken}}

### 17. 管理员确认收款
POST {{baseUrl}}/admin/orders/{{createdOrderId}}/confirm-payment
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "adminRemark": "已核对到账"
}

### 18. 管理员查询待发货订单
GET {{baseUrl}}/admin/orders?page=1&size=10&status=1
Authorization: Bearer {{adminToken}}

### 19. 管理员发货新订单
PUT {{baseUrl}}/admin/orders/{{createdOrderId}}/ship
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "shippingNo": "SF202605190001",
  "adminRemark": "已打包发出"
}

### 20. 用户确认收货
PUT {{baseUrl}}/orders/{{createdOrderId}}/confirm-receipt
Authorization: Bearer {{userToken}}

### 21. 管理员查看新订单操作审计日志
GET {{baseUrl}}/admin/orders/{{createdOrderId}}/logs
Authorization: Bearer {{adminToken}}

### 22. 用户再次加入购物车，用于取消待支付订单
POST {{baseUrl}}/cart
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "productId": 4,
  "quantity": 1
}

### 23. 查询购物车并记录商品 4 的购物车项 ID
GET {{baseUrl}}/cart
Authorization: Bearer {{userToken}}

> {%
  const item = response.body.data.find(row => row.productId === 4);
  if (item) {
    client.global.set("cancelOrderCartItemId", item.id);
  }
%}

### 24. 创建待取消订单
POST {{baseUrl}}/orders
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "addressId": {{demoAddressId}},
  "cartItemIds": [{{cancelOrderCartItemId}}]
}

> {% client.global.set("cancelOrderId", response.body.data.orderId); %}

### 25. 用户取消待支付订单，预期释放库存并回退销量
PUT {{baseUrl}}/orders/{{cancelOrderId}}/cancel
Authorization: Bearer {{userToken}}

### 26. 管理员查看取消订单操作审计日志
GET {{baseUrl}}/admin/orders/{{cancelOrderId}}/logs
Authorization: Bearer {{adminToken}}

### 27. 管理员查看统计数据
GET {{baseUrl}}/admin/statistics
Authorization: Bearer {{adminToken}}

### 28. 管理员上传商品图片
# 将 sample-product.png 替换为本地真实图片后执行。
POST {{baseUrl}}/admin/upload/product-image
Authorization: Bearer {{adminToken}}
Content-Type: multipart/form-data; boundary=mall-upload-boundary

--mall-upload-boundary
Content-Disposition: form-data; name="file"; filename="sample-product.png"
Content-Type: image/png

< ./sample-product.png
--mall-upload-boundary--

> {% client.global.set("uploadedImageUrl", response.body.data.url); %}

### 29. 普通用户上传商品图片，预期返回 403
POST {{baseUrl}}/admin/upload/product-image
Authorization: Bearer {{userToken}}
Content-Type: multipart/form-data; boundary=mall-upload-boundary

--mall-upload-boundary
Content-Disposition: form-data; name="file"; filename="sample-product.png"
Content-Type: image/png

< ./sample-product.png
--mall-upload-boundary--

### 30. 管理员查看所有订单状态样例
GET {{baseUrl}}/admin/orders?page=1&size=10
Authorization: Bearer {{adminToken}}

### 31. 管理员筛选低库存商品
GET {{baseUrl}}/admin/products?page=1&size=10&lowStock=true
Authorization: Bearer {{adminToken}}

### 32. 管理员查看用户订单概要
GET {{baseUrl}}/admin/users/2/order-summary
Authorization: Bearer {{adminToken}}

### 33. 普通用户访问后台，预期返回 403
GET {{baseUrl}}/admin/statistics
Authorization: Bearer {{userToken}}

### 34. 超库存加入购物车，预期失败
POST {{baseUrl}}/cart
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "productId": 11,
  "quantity": 999
}
